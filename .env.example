# Environment Configuration Template for NARADH
# Rename this file to .env for local development
# NEVER commit .env or actual secret keys to source control!

PORT=3000
NODE_ENV=development

# Gemini API Configuration (SERVER-SIDE ONLY)
GEMINI_API_KEY=YOUR_SERVER_GEMINI_API_KEY_HERE
GEMINI_ROUTER_MODEL=gemini-2.5-flash-lite

# Google OAuth Configuration
# GOOGLE_CLIENT_ID is public and passed to frontend for GIS sign-in button
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET is secret and used on backend if OAuth code flow is used
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# Session Security
SESSION_SECRET=naradh_secret_session_key_change_in_production_32chars

# Database Configuration
DATABASE_PATH=backend/db/naradh.db

# CORS Allowed Origin (if frontend and backend are deployed separately)
ALLOWED_ORIGIN=http://localhost:3000
