# BUNNY CLOUD - Moto G3 Private Personal Cloud Configuration
BUNNY_PORT=8082
BUNNY_HOST=127.0.0.1
BUNNY_ADMIN_USER=BUNNY
BUNNY_ADMIN_PASS=set_your_secure_cloud_password_here
BUNNY_STORAGE_ROOT=/sdcard/CloudStorage

# Security & Session Settings
BUNNY_ALLOWED_ORIGIN=https://bandajairaj2k5.github.io,http://localhost:8080
BUNNY_SESSION_TIMEOUT_MINUTES=30
BUNNY_MAX_LOGIN_ATTEMPTS=5
BUNNY_LOCKOUT_MINUTES=5

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=enter_your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=enter_your_telegram_user_id_here
TELEGRAM_INTERNAL_SECRET=bunny_internal_secret_key

# Portfolio Gemini AI Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

